[Unit]
Description=Color video capture for meteor clips
After=network-online.target
Wants=network-online.target
# Never give up restarting: RestartSec=60 already paces the restarts, and a
# start limit would leave colour capture dead for the night after a few
# failed starts (the watchdog heals only 3 times an hour). These keys sat in
# [Service] until 2026-10-05, where systemd ignores StartLimitIntervalSec
# with an "Unknown key" warning on every station.
StartLimitIntervalSec=0

[Service]
Type=simple
User=gmn
Group=gmn
ExecStart=/home/gmn/RMS/venv/bin/python /home/gmn/rovimen_scripts/color_capture.py -c /home/gmn/rovimen_scripts/config.json
CPUQuota=150%
Nice=5
IOSchedulingClass=idle
Restart=on-failure
RestartSec=60
MemoryMax=2G
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=LC_ALL=C.UTF-8

[Install]
WantedBy=multi-user.target
