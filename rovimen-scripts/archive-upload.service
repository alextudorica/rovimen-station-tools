[Unit]
Description=ROVIMEN archive uploader (POSTs clip bytes to the VPS ingest)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %h/rovimen_scripts/archive_upload.py -c %h/rovimen_scripts/config.json --daemon
Restart=always
RestartSec=60
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# Shares the pusher's ingest identity (ROVIMEN_HOST_KEY, ROVIMEN_INGEST_BASE_URL)
# so the byte uploader targets the same VPS with the same key. The '-' makes it
# optional; the updater generates it from the pusher unit on stations that only
# carry those vars inline in rovimen-pusher.service.
EnvironmentFile=-%h/.config/rovimen/ingest.env

[Install]
WantedBy=default.target
