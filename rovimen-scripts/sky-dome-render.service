[Unit]
Description=ROVIMEN station sky-dome renderer (composites + uploads the dome; offloads the VPS)
After=network-online.target rovimen-station-api.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %h/rovimen_scripts/sky_dome_render.py -c %h/rovimen_scripts/config.json --daemon
Restart=always
RestartSec=60
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# Shares the pusher's ingest identity (ROVIMEN_HOST_KEY, ROVIMEN_INGEST_BASE_URL)
# so the dome upload targets the same VPS with the same key as archive_upload /
# rovimen_pusher. The '-' makes it optional for stations that carry those vars
# inline in rovimen-pusher.service instead.
EnvironmentFile=-%h/.config/rovimen/ingest.env

[Install]
WantedBy=default.target
